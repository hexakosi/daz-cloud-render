{
  "name": "Portrait",
  "description": "Optimiert fuer Nahaufnahmen mit realistischer Haut",
  "global": {
    "subsurface_scale": 0.015,
    "specular": 0.5
  },
  "by_type": {
    "skin": {
      "match": ["skin", "face", "body", "lip", "ear", "hand", "head", "neck"],
      "subsurface_scale": 0.03,
      "subsurface_color": [0.85, 0.45, 0.35],
      "roughness": 0.35,
      "specular": 0.55
    },
    "eye": {
      "match": ["eye", "cornea", "iris", "sclera", "moisture", "tear"],
      "roughness": 0.02,
      "specular": 0.9,
      "coat": 1.0,
      "coat_roughness": 0.01
    },
    "lip": {
      "match": ["lip", "mouth"],
      "roughness": 0.25,
      "specular": 0.7,
      "subsurface_scale": 0.025,
      "subsurface_color": [0.9, 0.3, 0.3]
    },
    "hair": {
      "match": ["hair", "brow", "lash"],
      "roughness_offset": -0.15,
      "specular": 0.65
    }
  }
}
